<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Project">

        <!-- Main Login Screen (Launcher) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Customer Home Screen -->
        <activity
            android:name=".Home_page"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <!-- Authentication Activities -->
        <activity
            android:name=".auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".auth.AdminLoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Admin Management Activities -->
        <activity
            android:name=".admin.AdminDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".admin.InventoryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".admin.AddEditMedicineActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".admin.AdminOrdersActivity"
            android:exported="false" />

        <!-- Customer Shopping Activities -->
        <activity
            android:name=".customer.MedicineListActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".customer.MedicineDetailActivity"
            android:exported="false" />
        <activity
            android:name=".customer.CartActivity"
            android:exported="false" />
        <activity
            android:name=".customer.CheckoutActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".customer.BillActivity"
            android:exported="false" />
        <activity
            android:name=".customer.OrderHistoryActivity"
            android:exported="false" />
        <activity
            android:name=".customer.SymptomsActivity"
            android:exported="false" />

        <!-- FileProvider for Sharing and Viewing PDF Invoices -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
