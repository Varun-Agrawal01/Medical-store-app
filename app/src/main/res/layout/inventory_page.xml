<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:padding="16dp">

    <ImageButton
        android:id="@+id/btnBackInventory"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_revert"
        android:contentDescription="Back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textView26"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Inventory Management"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#111827"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@id/btnBackInventory"
        app:layout_constraintBottom_toBottomOf="@id/btnBackInventory"
        app:layout_constraintStart_toEndOf="@id/btnBackInventory"
        app:layout_constraintEnd_toStartOf="@id/btnAddMedicine" />

    <Button
        android:id="@+id/btnAddMedicine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+ Add"
        app:layout_constraintTop_toTopOf="@id/btnBackInventory"
        app:layout_constraintBottom_toBottomOf="@id/btnBackInventory"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/editTextText9"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Search medicine name or generic..."
        android:background="@android:drawable/editbox_background"
        android:paddingHorizontal="16dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnBackInventory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvInventoryMedicines"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/editTextText9"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>